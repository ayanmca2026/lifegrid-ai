# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/lifegrid

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
SECRET_KEY=replace_with_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Service URLs & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VITE_API_URL=http://localhost:8000/api
API_URL=http://localhost:8000/api

# Simulation Settings
SIMULATION_INTERVAL_SECONDS=1.5

# Google Maps (Frontend)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
